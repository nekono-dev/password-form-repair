---
// 雛形（Astro）: ユーザー名＋パスワード（＋任意の2段階認証）のログインフォーム。SKILL.md「疑うポイント」#1・#7・#8。
// 守ること:
// - autocompleteはusername / current-password。offにしない（フォームが出なくなる）。
// - 2段階認証欄は最初から<form>に置かない。<template>に置き、ボタンを押したときに<form>へ複製する（同居するとPassが反応しない）。
//   Astroの条件付き描画（{x && ...}）はサーバ側で一度だけ評価されるので、後からの追加には使えない。
// - <form>にはユーザー名・パスワード・送信ボタンだけを置く。他の欄は<form>の外の別の区画に置き、type="search"にする。
// - React/Preactの島（client:*）でフォームを描く場合は、templates/react・templates/preactの雛形を使う。
interface Props {
  // TODO: 送信先。JSで送信する場合は下の<script>のTODOを埋め、actionは外す。
  action?: string;
}
const { action } = Astro.props;
---

<section aria-label="ログイン">
  <form data-login-form action={action} method="post">
    <label>
      ユーザー名
      <input type="text" name="username" autocomplete="username" required />
    </label>
    <label>
      パスワード
      <input type="password" name="password" autocomplete="current-password" required />
    </label>
    <div data-two-factor-slot></div>
    <button type="button" data-two-factor-button>2段階認証を設定している場合</button>
    <button type="submit">ログイン</button>
  </form>
  <template data-two-factor-template>
    <label>
      2段階認証
      <input type="text" name="twoFactorCode" inputmode="numeric" autocomplete="off" />
    </label>
  </template>
</section>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>("form[data-login-form]")) {
    const section = form.parentElement!;
    const button = form.querySelector<HTMLButtonElement>("[data-two-factor-button]")!;
    button.addEventListener("click", () => {
      const template = section.querySelector<HTMLTemplateElement>("template[data-two-factor-template]")!;
      form.querySelector("[data-two-factor-slot]")!.append(template.content.cloneNode(true));
      button.remove();
    });
    // TODO: JSで送信する場合は、submitを横取りしてAPIを呼び、送信直後にパスワード欄を空にする。
  }
</script>
