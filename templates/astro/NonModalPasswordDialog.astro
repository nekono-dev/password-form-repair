---
// 雛形（Astro）: パスワード欄を持つ非モーダルのダイアログ（パスワードを再入力する確認ダイアログなど）。SKILL.md「疑うポイント」#2・#3・#5・#6。
// 守ること:
// - モーダル（showModal）にしない。トップレイヤーが拡張機能の候補表示を隠す。dialog.show()で開き、
//   ../non-modal-dialog.cssで中央に固定する（class="non-modal"）。
// - モーダルでないとEscで閉じないので、keydownで補う。
// - 閉じている間はフォームをDOMに置かない（閉じた<dialog>内のフォームは、開いても再検出されない）。
//   フォームは<template>に置き、開くたびに複製して追加し、閉じたら取り除く。
// - 「ログイン中のユーザー名」を可視のtext欄（autocomplete="username"）で置く。非表示・readonlyの欄は検出されない。
import "../non-modal-dialog.css";

interface Props {
  // 開くボタンのid（ページ側に置いたボタン）。
  openerId: string;
  // 現在のユーザー名（セッションなどから取得した値）。
  currentUsername: string;
  title: string;
}
const { openerId, currentUsername, title } = Astro.props;
---

<dialog class="non-modal" aria-label={title} data-password-dialog data-opener={openerId} data-current-username={currentUsername}>
  <h2>{title}</h2>
  <div data-form-slot></div>
  <template>
    <form>
      <label>
        ログイン中のユーザー名
        <input type="text" name="username" autocomplete="username" />
      </label>
      <label>
        ログインパスワード
        <input type="password" name="current-password" autocomplete="current-password" required />
      </label>
      <div class="dialog-actions">
        <button type="submit">実行</button>
        <button type="button" data-cancel>キャンセル</button>
      </div>
    </form>
  </template>
</dialog>

<script>
  for (const dialog of document.querySelectorAll<HTMLDialogElement>("dialog[data-password-dialog]")) {
    const slot = dialog.querySelector("[data-form-slot]")!;
    const open = () => {
      const fragment = dialog.querySelector("template")!.content.cloneNode(true) as DocumentFragment;
      const form = fragment.querySelector("form")!;
      (form.elements.namedItem("username") as HTMLInputElement).value = dialog.dataset.currentUsername ?? "";
      form.querySelector("[data-cancel]")!.addEventListener("click", () => dialog.close());
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const field = form.elements.namedItem("current-password") as HTMLInputElement;
        const password = field.value;
        field.value = "";
        // TODO: API呼び出し（password を送る）。成功したら dialog.close()。
      });
      slot.replaceChildren(fragment);
      dialog.show();
    };
    document.getElementById(dialog.dataset.opener!)?.addEventListener("click", open);
    dialog.addEventListener("keydown", (event) => event.key === "Escape" && dialog.close());
    dialog.addEventListener("close", () => slot.replaceChildren());
  }
</script>
