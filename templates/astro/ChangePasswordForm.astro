---
// 雛形（Astro）: ユーザー名・パスワードを変更するフォーム（現在のパスワード確認つき）。SKILL.md「疑うポイント」#1・#4・#5・#6。
// 守ること:
// - 欄順は「ユーザー名(username)・現在のパスワード(current-password)・新パスワード(new-password)」の3欄。
// - 「新しいユーザー名」の別text欄を置かない（位置・autocompleteによらず、現在のパスワード欄へ新パスワードが入る）。
//   ユーザー名の変更は、username欄を現在値で初期化し、受け取ったサーバ側でセッションの現在値と比べて、変わった場合だけ変更する。
//   現在値を送るためのhidden欄は足さない（分類への影響を検証していない）。
// - ラベルに「確認」「再入力」を含めない（確認欄と誤判定される）。
// - ダイアログ内に置く場合は NonModalPasswordDialog.astro のとおり、開いたときだけDOMへ追加する。
interface Props {
  // 現在のユーザー名（セッションなどから取得した値）。
  currentUsername: string;
  // TODO: 送信先。
  action?: string;
}
const { currentUsername, action } = Astro.props;
---

<form data-change-password-form action={action} method="post">
  <label>
    ユーザー名（変更する場合は書き換える）
    <input type="text" name="username" autocomplete="username" value={currentUsername} />
  </label>
  <label>
    現在のパスワード
    <input type="password" name="current-password" autocomplete="current-password" required />
  </label>
  <label>
    新しいパスワード（変更する場合のみ）
    <input type="password" name="new-password" autocomplete="new-password" />
  </label>
  <button type="submit">変更</button>
</form>
